{
  "name": "yucp-creator-assistant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-prometheus": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@babel/core": "7.29.7",
    "@protobufjs/utf8": ">=1.1.1",
    "@tanstack/start-server-core": "1.169.8",
    "axios": ">=1.18.0",
    "bebop": "3.0.4",
    "fast-xml-parser": "5.7.0",
    "fast-xml-builder": ">=1.2.0",
    "h3": "2.0.1-rc.20",
    "happy-dom": ">=20.8.8",
    "kysely": "0.28.17",
    "lodash": ">=4.18.1",
    "picomatch": "2.3.2",
    "prismjs": ">=1.30.0",
    "protobufjs": "7.6.5",
    "defu": ">=6.1.6",
    "esbuild": "0.28.1",
    "undici": "7.28.0",
    "vite": ">=8.0.16",
    "follow-redirects": ">=1.15.12",
    "@smithy/config-resolver": ">=4.4.0",
    "srvx": ">=0.11.13",
    "@babel/runtime": "7.29.7",
    "@grpc/grpc-js": ">=1.14.4",
    "postcss": ">=8.5.10",
    "uuid": ">=14.0.0",
    "ws": ">=8.20.1",
    "better-auth": "1.6.23",
    "@better-auth/api-key": "1.6.23",
    "@better-auth/core": "1.6.23",
    "@better-auth/oauth-provider": "1.6.23",
    "@better-auth/passkey": "1.6.23",
    "shell-quote": "1.10.0",
    "tar": "7.5.20",
    "form-data": "4.0.6",
    "js-yaml": "4.3.0",
    "@opentelemetry/propagator-jaeger": "2.10.0",
    "sharp": "0.35.3"
  },
  "scripts": {
    "bebop:regenerate": "bun run --filter @yucp/private-rpc generate",
    "icons:sync": "bun run --env-file=.env.infisical ops/icons/sync.ts",
    "lint": "biome check ops/docs ops/storage-core ops/catalog ops/ingest-pipeline ops/ingest-tus ops/testing services/delivery-worker && bun run --filter '*' lint",
    "contracts:check": "bun run --filter @yucp/private-rpc check:generated",
    "typecheck": "bun run contracts:check && tsc -b tsconfig.solution.json --pretty false && bun run typecheck:docs && bun run typecheck:storage-core && bun run typecheck:importer && bun run typecheck:catalog && bun run typecheck:ingest && bun run typecheck:ingest-tus && bun run typecheck:gc && bun run typecheck:scheduler && bun run typecheck:delivery-worker && bun run --filter '@yucp/api' typecheck && bun run --filter '@yucp/bot' typecheck && bun run --filter '@yucp/web' typecheck",
    "typecheck:storage-core": "tsc --noEmit -p ops/storage-core/tsconfig.json --pretty false",
    "typecheck:importer": "tsc --noEmit -p ops/importer/tsconfig.json --pretty false",
    "typecheck:catalog": "tsc --noEmit -p ops/catalog/tsconfig.json --pretty false",
    "typecheck:ingest": "tsc --noEmit -p ops/ingest-pipeline/tsconfig.json --pretty false",
    "typecheck:ingest-tus": "tsc --noEmit -p ops/ingest-tus/tsconfig.json --pretty false",
    "typecheck:gc": "tsc --noEmit -p ops/gc/tsconfig.json --pretty false",
    "typecheck:scheduler": "tsc --noEmit -p ops/scheduler/tsconfig.json --pretty false",
    "typecheck:delivery-worker": "bun x wrangler types services/delivery-worker/worker-configuration.d.ts --config services/delivery-worker/wrangler.toml --check && tsc --noEmit -p services/delivery-worker/tsconfig.json --pretty false && tsc --noEmit -p services/delivery-worker/tsconfig.test.json --pretty false",
    "test:storage:unit": "bun test ./ops/storage-core/config.test.ts ./ops/storage-core/deliverySigning.test.ts ./ops/storage-core/vpmToken.test.ts ./ops/storage-core/canonicalizer.security.test.ts ./ops/testing/postgresReadiness.test.ts ./ops/testing/minioReadiness.test.ts",
    "test:gc:e2e": "bun test --timeout 300000 --max-concurrency 1 ./ops/gc/chunkGc.e2e.test.ts",
    "test:cas:e2e": "bun test --timeout 180000 --max-concurrency 1 ./ops/storage-core/storageCore.e2e.test.ts",
    "test:cas:s3": "bun test --timeout 300000 --max-concurrency 1 ./ops/storage-core/config.test.ts ./ops/storage-core/s3Cas.e2e.test.ts",
    "test:importer:e2e": "bun test --timeout 300000 --max-concurrency 1 ./ops/importer/importVersion.e2e.test.ts",
    "smoke:cas:b2": "bun run --env-file=.env.infisical ops/storage-core/smoke-b2.ts",
    "ingest:tus:serve": "bun run --env-file=.env.infisical ops/ingest-tus/server.ts",
    "scheduler:serve": "bun run --env-file=.env.infisical ops/scheduler/server.ts",
    "test:catalog:integration": "bun test --timeout 180000 --max-concurrency 1 ./ops/catalog/catalog.integration.test.ts",
    "test:ingest:e2e": "bun test --timeout 180000 --max-concurrency 1 ./ops/ingest-pipeline/ingestPipeline.e2e.test.ts",
    "test:pipeline:promote:e2e": "bun test --timeout 300000 --max-concurrency 1 ./ops/ingest-pipeline/promotePipeline.e2e.test.ts",
    "test:scheduler:e2e": "bun test --timeout 300000 --max-concurrency 1 ./ops/scheduler/scheduler.e2e.test.ts",
    "test:accept:5gb": "bun test --timeout 10800000 --max-concurrency 1 ./ops/ingest-pipeline/accept5gb.e2e.test.ts",
    "test:ingest-tus:e2e": "bun test --timeout 180000 --max-concurrency 1 ./ops/ingest-tus/ingestTusServer.e2e.test.ts",
    "test:delivery:e2e": "tsx ./services/delivery-worker/deliveryWorker.e2e.test.ts",
    "test:storage:e2e": "bun run test:storage-harness:e2e && bun run test:cas:e2e && bun run test:cas:s3 && bun run test:catalog:integration && bun run test:ingest:e2e && bun run test:ingest-tus:e2e && bun run test:delivery:e2e && bun run test:importer:e2e && bun run test:pipeline:promote:e2e && bun run test:gc:e2e && bun run test:scheduler:e2e",
    "test": "bun run test:fast",
    "test:ops": "bun test ./ops/docs/ste.test.ts ./ops/node-dependency-resolution.contract.test.ts ./ops/dev-supervisor.test.ts ./ops/convex-infisical-env.test.ts ./ops/convex-better-auth-compat.test.ts ./ops/convex-real/ci-workflow.test.ts ./ops/convex-real/deploy-gate.contract.test.ts ./ops/convex-real/e2e-runner.test.ts ./ops/convex-real/manage.test.ts ./ops/convex-real/preflight.test.ts ./ops/icons/assetsConfig.test.ts ./ops/icons/ciWorkflow.test.ts ./ops/icons/runWebWithIcons.test.ts ./ops/icons/transform.test.ts ./ops/web-vite-config.contract.test.ts ./ops/web-stylelint-config.contract.test.ts ./ops/public-api-rate-limit-wiring.contract.test.ts ./ops/heroui-install-token.contract.test.ts ./ops/cloudflare-workers-builds.contract.test.ts ./ops/github-workflows-bun-version.contract.test.ts ./ops/dependency-security-overrides.contract.test.ts ./ops/web-dev-runtime.test.ts ./ops/buyer-attribution-remediation.test.ts ./ops/subject-ownership-remediation.test.ts ./ops/provider-live-smoke.test.ts ./ops/production-regression-loop.test.ts",
    "test:external-integrations": "bun run --filter '@yucp/web' icons:run -- external-integrations",
    "test:fast": "bun run test:ops && bun run test:storage:unit && bun run --filter '@yucp/api' test && bun run --filter '@yucp/application' test && bun run --filter '@yucp/policy' test && bun run --filter '@yucp/providers' test && bun run --filter '@yucp/shared' test",
    "test:convex:types": "tsc --noEmit -p convex/tsconfig.json",
    "test:convex": "bun run test:convex:types && bun x vitest run --config convex/vitest.config.ts",
    "test:convex:real:up": "bun run ops/convex-real/manage.ts up",
    "test:convex:deploy": "bun run ops/convex-real/deploy-gate.ts",
    "test:convex:real": "bun run ops/convex-real/manage.ts test-signals && bun test --timeout 60000 --max-concurrency 1 ./ops/convex-real/real-backend-smoke.test.ts ./ops/convex-real/real-backend-suite.test.ts",
    "test:convex:real:down": "bun run ops/convex-real/manage.ts down",
    "test:convex:images:freshness": "bun run ops/convex-real/check-image-freshness.ts",
    "test:flow:e2e:run": "bun test --timeout 300000 --max-concurrency 1 ./apps/api/test/e2e/buyer-delivery-flow.e2e.test.ts",
    "test:flow:e2e": "bun run apps/api/test/e2e/support/runBuyerDeliveryFlow.ts",
    "test:e2e:flows:run": "bun test --timeout 60000 --max-concurrency 1 ./apps/api/test/e2e/user-journeys.test.ts",
    "test:e2e:flows": "bun run apps/api/test/e2e/support/runE2EFlows.ts",
    "test:convex:prepare": "bun run infisical:convex -- bun x convex dev --once",
    "test:convex:prepare:debug": "bun run infisical:convex -- bun x convex dev --once --debug-node-apis",
    "test:api:integration": "bun test ./apps/api/test/backfill.test.ts ./apps/api/test/collab.test.ts ./apps/api/test/connect.test.ts ./apps/api/test/index.test.ts ./apps/api/test/providerPlatform.test.ts ./apps/api/test/public.test.ts ./apps/api/test/setupSession.security.test.ts ./apps/api/test/verification.test.ts ./apps/api/test/webhooks.test.ts ./apps/api/test/providers",
    "test:bot": "cross-env INTERNAL_SERVICE_AUTH_SECRET=test-internal-service-auth-secret bun test ./apps/bot/test/commands",
    "test:all": "bun run test:fast && bun run test:convex && bun run test:api:integration && bun run test:bot && bun run --filter '@yucp/web' test:ci",
    "test:infisical": "bun run --env-file=.env.infisical test",
    "test:boundary-mocks": "node ./ops/check-boundary-mock-ratchet.mjs",
    "test:ci": "bun run test:ops && bun run test:fast:ci && bun run test:boundary-mocks && bun run test:convex && bun run test:api:integration",
    "test:fast:ci": "bun run test:storage:unit && bun run --filter '@yucp/api' test:ci && bun run --filter '@yucp/application' test:ci && bun run --filter '@yucp/policy' test:ci && bun run --filter '@yucp/providers' test:ci && bun run --filter '@yucp/shared' test:ci",
    "test:api:e2e": "bun run --filter '@yucp/api' test:e2e",
    "test:bot:e2e": "bun run --filter '@yucp/bot' test:e2e",
    "test:bot:e2e:ci": "bun run --filter '@yucp/bot' test:e2e:ci",
    "capture:discord-storage": "tsx ops/capture-discord-storage-state.ts",
    "ops:buyer-attribution-remediation": "bun run ops/buyer-attribution-remediation.ts",
    "ops:subject-ownership-remediation": "bun run ops/subject-ownership-remediation.ts",
    "build:docs:index": "bun run --filter @yucp/api build:docs:index",
    "build": "bun run --filter '*' build",
    "dev": "bun run ops/dev-supervisor.ts",
    "dev:infisical": "bun run ops/dev-supervisor.ts --infisical",
    "dev:hyperdx": "bun run ops/hyperdx-dev.ts",
    "dev:hyperdx:infisical": "bun run --env-file=.env.infisical ops/hyperdx-dev.ts",
    "sync:convex:env": "bun run --env-file=.env.infisical ops/sync-convex-env.ts",
    "sync:convex:env:prod": "bun run --env-file=.env.infisical ops/sync-convex-env.ts --prod",
    "smoke:providers": "bun run ops/provider-live-smoke.ts",
    "smoke:providers:refresh-fixtures": "bun run ops/provider-live-smoke.ts --refresh-fixtures",
    "cloudflare:worker:deploy": "bun install --frozen-lockfile && bun run --filter @yucp/web worker:deploy -- --prod",
    "cloudflare:worker:version:upload": "bun install --frozen-lockfile && bun run --filter @yucp/web worker:version:upload",
    "delivery:worker:secrets:sync": "bun run --env-file=.env.infisical ops/sync-delivery-worker-secrets.ts",
    "infisical:convex": "bun run --env-file=.env.infisical ops/infisical-convex-run.ts",
    "infisical:convex:prod": "bun run --env-file=.env.infisical ops/infisical-convex-run.ts --prod",
    "dev:api": "cross-env FRONTEND_URL=http://localhost:3000 bun run --watch apps/api/src/index.ts",
    "dev:api:infisical": "bun run --env-file=.env.infisical dev:api",
    "dev:bot": "bun run --watch apps/bot/src/index.ts",
    "dev:bot:infisical": "bun run --env-file=.env.infisical dev:bot",
    "dev:web": "bun run --filter @yucp/web worker:dev",
    "dev:web:infisical": "bun run --env-file=.env.infisical ops/run-web-worker-infisical.ts",
    "convex:dev": "bun x convex dev",
    "convex:deploy": "bun x convex deploy",
    "start:api:infisical": "cross-env INFISICAL_ENV=prod bun run --filter @yucp/api start",
    "start:bot:infisical": "cross-env INFISICAL_ENV=prod bun run --filter @yucp/bot start",
    "start:web": "bun run --filter @yucp/web preview",
    "start:all": "concurrently -k \"bun run start:api:infisical\" \"bun run start:bot:infisical\" \"bun run start:web\"",
    "docs:ste": "bun run ops/docs/ste.ts",
    "typecheck:docs": "tsc --noEmit -p ops/docs/tsconfig.json --pretty false",
    "test:storage-harness:e2e": "bun test --timeout 300000 --max-concurrency 1 ./ops/testing/disposableStorageHarness.e2e.test.ts",
    "test:package-contracts": "bun test ./ops/storage-core/packageContractsV2.test.ts",
    "test:coupling:linux": "bun test --timeout 300000 --max-concurrency 1 ./ops/storage-core/linuxMaterialization.realtest.ts",
    "contracts:package:regenerate": "bun run ./ops/storage-core/generatePackageContractVectors.ts --output ./ops/storage-core/fixtures/package-contracts-v2.json",
    "test:desync-packing:e2e": "bun test --timeout 180000 --max-concurrency 1 ./ops/storage-core/desyncPacking.e2e.test.ts",
    "test:desync-caidx": "bun test --timeout 10800000 --max-concurrency 1 ./ops/storage-core/desyncCaidx.realtest.ts",
    "test:desync-http:e2e": "bun test --timeout 180000 --max-concurrency 1 ./ops/storage-core/desyncHttpStore.e2e.test.ts",
    "test:storage:corpus": "bun test --timeout 10800000 --max-concurrency 1 ./ops/storage-core/desyncCorpus.realtest.ts",
    "test:storage:file-profiles": "bun test --timeout 10800000 --max-concurrency 1 ./ops/storage-core/desyncFileProfiles.realtest.ts",
    "test:storage:longtail": "bun test --timeout 10800000 --max-concurrency 1 ./ops/storage-core/longtailCorpus.realtest.ts",
    "fixture:storage-corpus": "bun run ./ops/storage-core/buildPackageCorpus.ts",
    "test:storage:corpus-fixture": "bun test ./ops/storage-core/packageCorpus.test.ts",
    "test:vpm-cli:e2e": "bun test --timeout 900000 --max-concurrency 1 ./ops/importer/vpmBootstrap.e2e.test.ts",
    "test:docs:ste": "bun test ./ops/docs/ste.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@edge-runtime/vm": "^5.0.0",
    "@infisical/sdk": "^4.0.6",
    "@types/bun": "^1.3.10",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.4.0",
    "@types/three": "^0.183.1",
    "bebop-tools": "^3.2.3",
    "bun-types": "^1.3.10",
    "concurrently": "^9.1.0",
    "convex-test": "0.0.54",
    "cross-env": "^7.0.3",
    "playwright": "^1.53.0",
    "tsx": "^4.21.0",
    "tus-js-client": "4.3.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0",
    "wrangler": "4.83.0"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.23",
    "@better-auth/core": "1.6.23",
    "@better-auth/oauth-provider": "1.6.23",
    "@better-auth/passkey": "1.6.23",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/workpool": "0.4.7",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^2.0.1",
    "@polar-sh/better-auth": "^1.8.3",
    "@polar-sh/sdk": "^0.46.6",
    "@tempojs/client": "^0.0.12",
    "@tempojs/cloudflare-worker-router": "^0.0.12",
    "@tempojs/server": "^0.0.12",
    "@tus/file-store": "2.1.0",
    "@tus/server": "2.4.1",
    "aws4fetch": "1.0.20",
    "bebop": "3.0.4",
    "better-auth": "1.6.23",
    "buffer": "^6.0.3",
    "convex": "1.42.1",
    "convex-helpers": "0.1.120",
    "dotenv": "^17.3.1",
    "fflate": "^0.8.2",
    "h3-v2": "npm:h3@2.0.1-rc.20",
    "jsonc-parser": "^3.3.1",
    "postgres": "3.4.9",
    "tar": "7.5.20",
    "cborg": "^5.1.8"
  },
  "trustedDependencies": [
    "heroui-pro",
    "@heroui-pro/react",
    "heroui-native-pro"
  ],
  "description": "![YUCP Creator Assistant](https://github.com/user-attachments/assets/592a7c28-0bec-4673-9a43-0656d2a9ca6c)",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yeusepe/YUCP-Creator-Assistant.git"
  },
  "keywords": [],
  "author": "",
