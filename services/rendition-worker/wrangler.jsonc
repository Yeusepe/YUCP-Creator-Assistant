{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yucp-rendition-delivery",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // This worker serves both contract routes, so both have to reach it: a coupled
  // download that falls through the zone answers 404 and the buyer client reports
  // the rendition as missing.
  "routes": [
    {
      "pattern": "delivery.yucp.club/v2/renditions*",
      "zone_name": "yucp.club"
    },
    {
      "pattern": "delivery.yucp.club/v2/coupled/*",
      "zone_name": "yucp.club"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "PACKAGE_DELIVERY_AUDIENCE": "https://delivery.example.invalid",
    "PACKAGE_INSTALL_ISSUER": "https://api.example.invalid",
    "PACKAGE_INSTALL_SIGNING_KEY_ID": "configure-through-deployment",
    "PACKAGE_INSTALL_SIGNING_PUBLIC_KEY": "configure-through-deployment",
    "RENDITION_RECEIPT_KEY_ID": "configure-through-deployment",
    "RENDITION_RECEIPT_PUBLIC_KEY": "configure-through-deployment",
    "MATERIALIZER_ORIGIN_URL": "https://materializer.example.invalid"
  },
  "secrets": {
    "required": ["MATERIALIZER_RENDITION_SHARED_SECRET"]
  }
}
