{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yucp-rendition-delivery",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "PACKAGE_DELIVERY_AUDIENCE": "https://delivery.example.invalid",
    "PACKAGE_INSTALL_ISSUER": "https://api.example.invalid",
    "PACKAGE_INSTALL_SIGNING_KEY_ID": "configure-through-deployment",
    "PACKAGE_INSTALL_SIGNING_PUBLIC_KEY": "configure-through-deployment",
    "RENDITION_RECEIPT_KEY_ID": "configure-through-deployment",
    "RENDITION_RECEIPT_PUBLIC_KEY": "configure-through-deployment",
    "RENDITION_S3_BUCKET": "configure-through-deployment",
    "RENDITION_S3_ENDPOINT": "https://s3.us-west-004.backblazeb2.com",
    "RENDITION_S3_REGION": "us-west-004"
  }
}
