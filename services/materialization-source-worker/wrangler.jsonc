{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yucp-materialization-source-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "COMMON_CHUNK_PREFIX": "chunks/",
    "COMMON_S3_BUCKET": "configure-through-deployment",
    "COMMON_S3_ENDPOINT": "https://s3.us-west-004.backblazeb2.com",
    "COMMON_S3_REGION": "us-west-004",
    "DELIVERY_GRANT_ISSUER": "https://api.example.invalid",
    "DELIVERY_GRANT_KEY_ID": "configure-through-deployment",
    "DELIVERY_GRANT_PUBLIC_KEY": "configure-through-deployment",
    "MATERIALIZATION_SOURCE_AUDIENCE": "https://source.example.invalid",
    "METADATA_INDEX_PREFIX": "indexes/",
    "METADATA_S3_BUCKET": "configure-through-deployment",
    "METADATA_S3_ENDPOINT": "https://s3.us-west-004.backblazeb2.com",
    "METADATA_S3_REGION": "us-west-004",
    "PROTECTED_CHUNK_PREFIX": "chunks/",
    "PROTECTED_S3_BUCKET": "configure-through-deployment",
    "PROTECTED_S3_ENDPOINT": "https://s3.us-west-004.backblazeb2.com",
    "PROTECTED_S3_REGION": "us-west-004",
    "STORAGE_FORMAT_VERSION": "desync-uncompressed-sha256-v1"
  }
}
