# ── Catalog (PostgreSQL) ──────────────────────────────
CATALOG_DATABASE_URL=            # postgres://user:pass@host:5432/db — catalog source of truth

# ── CAS chunk store (Backblaze B2, S3 API) — NEEDED FOR REMOTE STORE ──
CAS_S3_ENDPOINT=                 # B2 S3 endpoint, e.g. https://s3.us-west-004.backblazeb2.com (B2 → bucket → Endpoint)
CAS_S3_REGION=                   # region substring of the endpoint, e.g. us-west-004
CAS_S3_BUCKET=                   # private B2 bucket for chunks (B2 → Buckets → Create a Bucket, Private)
CAS_S3_ACCESS_KEY_ID=            # B2 keyID (Application Keys → Add a New Application Key, bucket-scoped, Read+Write)
CAS_S3_SECRET_ACCESS_KEY=        # B2 applicationKey (shown once on key creation)
CAS_CHUNK_PREFIX=chunks/         # object-key prefix for chunk store (optional; default chunks/)
CAS_INDEX_PREFIX=indexes/        # object-key prefix for artifact indexes (optional; default indexes/)

# ── Ingest (tus resumable upload) ─────────────────────
INGEST_UPLOAD_DIR=               # local disk dir for in-progress tus uploads
INGEST_MAX_BYTES=5368709120      # max upload size in bytes (default ~5 GiB)
INGEST_TUS_URL=                  # public ingest-tus origin, e.g. https://ingest.example.com
UPLOAD_HMAC_KEY=                 # shared API/ingest capability key; generate: openssl rand -hex 32

# ── Delivery (Cloudflare Worker/CDN) — NEEDED FOR DELIVERY INCREMENT (can wait) ──
CF_ACCOUNT_ID=                   # Cloudflare account ID (dashboard → Workers overview / right sidebar)
CF_API_TOKEN=                    # Cloudflare API token — Workers Scripts: Edit + Account: Read (My Profile → API Tokens)
DELIVERY_HMAC_KEY=               # signs delivery URLs; generate: openssl rand -hex 32
DELIVERY_BASE_URL=               # public delivery Worker origin, e.g. https://delivery.example.com
VPM_BASE_URL=                    # optional public API origin for buyer VPM indexes; routes return 503 when unset
CAS_S3_READONLY_ACCESS_KEY_ID=   # B2 read-only keyID the Worker uses to fetch private chunks on cache miss
CAS_S3_READONLY_SECRET_ACCESS_KEY= # B2 read-only applicationKey for the Worker
